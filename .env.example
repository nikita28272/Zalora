# Скопируйте этот файл в .env и заполните. Файл .env НЕ коммитить в git.

# --- Обязательные ключи ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш Telegram ID: запустите бота без него, напишите боту что угодно, он пришлёт ID
TELEGRAM_OWNER_ID=
# https://the-odds-api.com (бесплатно 500 кредитов/мес)
ODDS_API_KEY=
# https://www.football-data.org/client/register (бесплатно)
FOOTBALL_DATA_API_KEY=

# --- Режим агентов ---
# manual — «босс в чате» (по умолчанию): бот готовит досье, разбор с субагентами делает Claude
#          в чате, вердикт возвращается в бот командой /verdict. Ключ Claude API не нужен.
# api    — агенты работают через Claude API прямо в боте (нужен ANTHROPIC_API_KEY).
AGENTS_MODE=manual
MANUAL_CANDIDATES_PER_SCAN=3
# Только для AGENTS_MODE=api: ключ с https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# --- Claude API: модели и расходы (только для AGENTS_MODE=api) ---
# Экономичный режим (по умолчанию): босс на Opus, помощники на Sonnet.
# Полный режим: LLM_MODEL_AGENTS=claude-opus-5-5 (примерно в 1.5–2 раза дороже).
LLM_MODEL_CHIEF=claude-opus-5-5
LLM_MODEL_AGENTS=claude-sonnet-5-5
LLM_EFFORT_CHIEF=medium
LLM_EFFORT_AGENTS=low
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_USES=3
MAX_LLM_MATCHES_PER_SCAN=2
MAX_LLM_ANALYSES_PER_DAY=3

# --- Сигналы ---
# Минимальный перевес над коэффициентом (0.03 = 3%)
MIN_EDGE=0.03
# Модель лишь корректирует рынок: сдвигает его оценку на эту долю разницы (0.35 = на треть)
MODEL_WEIGHT=0.35
# Если модель расходится с рынком больше чем на столько (0.12 = 12 п.п.), исход не кандидат: скорее ошибка модели
MAX_MODEL_GAP=0.12
# Насколько главный аналитик может разойтись с рынком (0.08 = 8 п.п.)
MAX_PROB_DEVIATION=0.08
MIN_ODDS=1.40
MAX_ODDS=4.50
LOOKAHEAD_HOURS=48
# Какие лиги сканировать и в каком порядке приоритета: PL,PD,SA,BL1,FL1,CL,NHL (пусто — все).
# При нехватке кредитов первыми откладываются лиги в конце списка.
ENABLED_LEAGUES=

# --- Экономия кредитов The Odds API (500 бесплатно в месяц) ---
# /matches и досье берут линии из кеша, если им не больше N минут
ODDS_CACHE_MINUTES=120
# ежедневный скан обновляет линии, если им больше N минут
ODDS_SCAN_MAX_AGE_MINUTES=60
# день месяца, когда обновляется лимит (дата регистрации в The Odds API — см. личный кабинет)
ODDS_RESET_DAY=1
# запас кредитов, который бот не трогает
ODDS_RESERVE=20
# Только прематч: матчи, до начала которых меньше N минут, не разбираются
MIN_MINUTES_BEFORE_KICKOFF=60
# Отбор «⭐ Стоит разобрать»: сколько матчей и с какой оценки перевеса (−0.01 = −1%)
TOP_MATCHES=5
# НБА: analysis — ставки по анализу (агенты, травмы, график), value — по перевесу, как в других лигах
NBA_MODE=analysis
NBA_TOP=3
NBA_MIN_FACTOR=2.0
NBA_STAKE_PCT=0.01
NBA_MAX_PROB_DEVIATION=0.12
TOP_MIN_EDGE=-0.01
# Режим «босс в чате»: /verdict принимается не позже чем за столько минут до начала
VERDICT_CUTOFF_MINUTES=10
# Напоминание о поздней проверке (вратари / составы) — за столько минут до начала
LATE_CHECK_HOCKEY_MINUTES=120
LATE_CHECK_BASKETBALL_MINUTES=60
LATE_CHECK_FOOTBALL_MINUTES=50
# Тихие часы для напоминаний («0-7» — не присылать с 00 до 07); пусто — присылать и ночью
QUIET_HOURS=

# --- Финансист ---
START_BANKROLL=10000
KELLY_FRACTION=0.25
MAX_STAKE_PCT=0.02
MAX_BETS_PER_DAY=3
DAILY_LOSS_LIMIT_PCT=0.05
STOP_AFTER_LOSSES=4

# --- Расписание ---
TIMEZONE=Europe/Moscow
SCAN_TIME=11:00
SETTLE_TIME=09:00

DB_PATH=data/bot.db
